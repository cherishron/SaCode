{
  "pciv": {
    "version": "2.0.0",
    "language": "zh-CN",
    "validation": {
      "autoValidate": true,
      "checks": {
        "type": true,
        "lint": true,
        "test": false,
        "security": false
      }
    },
    "mistakeBook": {
      "enabled": true,
      "autoExtract": true,
      "requireConfirm": true
    },
    "techStack": {
      "autoDetect": true,
      "templates": [
        "nextjs",
        "react",
        "vue",
        "python"
      ]
    }
  }
}
