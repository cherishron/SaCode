## ToolRegistry 注册代码

```rust
impl ToolRegistry {
    pub fn builtin() -> Self {
        let mut tools = HashMap::new();
        
        // 文件系统工具
        tools.insert("fs.read".to_string(), fs::read::spec());
        tools.insert("fs.write".to_string(), fs::write::spec());
        tools.insert("fs.edit".to_string(), fs::edit::spec());
        tools.insert("fs.search".to_string(), fs::search::spec());
        tools.insert("fs.list".to_string(), fs::list::spec());
        tools.insert("fs.read_multi".to_string(), fs::read_multi::spec());
        
        // Git 工具
        tools.insert("git.diff".to_string(), git::diff::spec());
        
        // Shell 工具
        tools.insert("shell.exec".to_string(), shell::exec::spec());
        
        // 网络工具
        tools.insert("web.fetch".to_string(), web::fetch::spec());
        tools.insert("web.search".to_string(), web::search::spec());
        
        // 媒体工具
        tools.insert("media.read".to_string(), media::read::spec());
        
        // 交互工具
        tools.insert("interaction.ask".to_string(), interaction::ask::spec());
        
        // 任务工具
        tools.insert("task.spawn".to_string(), task::spawn::spec());
        
        // Phase 1: Memory 工具
        tools.insert("memory.recall".to_string(), memory::recall::spec());
        tools.insert("memory.remember".to_string(), memory::remember::spec());
        tools.insert("memory.search".to_string(), memory::search::spec());
        
        // Phase 1: Skill 工具
        tools.insert("skill.activate".to_string(), skill::activate::spec());
        
        // Phase 1: MCP 工具
        tools.insert("mcp.call".to_string(), mcp_call::call::spec());
        
        // Phase 2: Checkpoint 工具
        tools.insert("checkpoint.save".to_string(), checkpoint::save::spec());
        tools.insert("checkpoint.restore".to_string(), checkpoint::restore::spec());
        tools.insert("checkpoint.list".to_string(), checkpoint::list::spec());
        
        // Phase 3: 配置/知识工具
        tools.insert("profile.switch".to_string(), profile::switch::spec());
        tools.insert("config.read".to_string(), config_tool::read::spec());
        tools.insert("wiki.query".to_string(), wiki_tool::query::spec());
        tools.insert("insight.read".to_string(), insight_tool::read::spec());
        
        Self { tools }
    }

    pub fn execute(&self, name: &str, input: serde_json::Value) -> anyhow::Result<ToolOutput> {
        match name {
            // 文件系统
            "fs.read" => fs::read::execute(input),
            "fs.write" => fs::write::execute(input),
            "fs.edit" => fs::edit::execute(input),
            "fs.search" => fs::search::execute(input),
            "fs.list" => fs::list::execute(input),
            "fs.read_multi" => fs::read_multi::execute(input),
            
            // Git
            "git.diff" => git::diff::execute(input),
            
            // Shell
            "shell.exec" => shell::exec::execute(input),
            
            // 网络
            "web.fetch" => web::fetch::execute(input),
            "web.search" => web::search::execute(input),
            
            // 媒体
            "media.read" => media::read::execute(input),
            
            // 交互
            "interaction.ask" => interaction::ask::execute(input),
            
            // 任务
            "task.spawn" => task::spawn::execute(input),
            
            // Phase 1: Memory
            "memory.recall" => memory::recall::execute(input),
            "memory.remember" => memory::remember::execute(input),
            "memory.search" => memory::search::execute(input),
            
            // Phase 1: Skill
            "skill.activate" => skill::activate::execute(input),
            
            // Phase 1: MCP (async, 需要特殊处理)
            "mcp.call" => {
                let rt = tokio::runtime::Builder::new_current_thread()
                    .enable_all()
                    .build()?;
                rt.block_on(mcp_call::call::execute(input))
            }
            
            // Phase 2: Checkpoint
            "checkpoint.save" => checkpoint::save::execute(input),
            "checkpoint.restore" => checkpoint::restore::execute(input),
            "checkpoint.list" => checkpoint::list::execute(input),
            
            // Phase 3: 配置/知识
            "profile.switch" => profile::switch::execute(input),
            "config.read" => config_tool::read::execute(input),
            "wiki.query" => wiki_tool::query::execute(input),
            "insight.read" => insight_tool::read::execute(input),
            
            _ => anyhow::bail!("unknown tool: {}", name),
        }
    }
}
```

