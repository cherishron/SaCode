pub fn spec() -> ToolSpec {
    ToolSpec {
        name: "memory.recall".to_string(),
        description: "召回当前项目的相关记忆，包括通用经验、用户偏好、工作流和决策".to_string(),
        input_schema: serde_json::json!({
            "type": "object",
