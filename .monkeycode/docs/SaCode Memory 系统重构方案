## 工具实现

### memory.recall

```rust
pub fn spec() -> ToolSpec {
    ToolSpec {
        name: "memory.recall".to_string(),
        description: "根据当前任务上下文，召回最相关的记忆条目".to_string(),
        input_schema: serde_json::json!({
            "type": "object",
            "properties": {
                "context": { "type": "string", "description": "当前任务上下文描述" },
                "limit": { "type": "integer", "description": "召回数量，默认 5" }
            },
            "required": ["context"]
        }),
        output_schema: serde_json::json!({
            "type": "object",
            "properties": {
                "memories": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "content": { "type": "string" },
                            "kind": { "type": "string" },
                            "scope": { "type": "string" },
                            "tags": { "type": "array", "items": { "type": "string" } }
                        }
                    }
                },
                "count": { "type": "integer" }
            }
        }),
        side_effect_level: SideEffectLevel::ReadOnly,
        approval_required: false,
        timeout_ms: Some(5000),
        tags: vec!["memory".to_string()],
    }
}
```

**召回算法（无 Embedding 版）**：

```rust
pub fn recall(&self, context: &str, limit: usize) -> Vec<&MemoryEntry> {
    let context_lower = context.to_lowercase();
    let context_words: Vec<&str> = context_lower.split_whitespace().collect();
    
    let mut scored: Vec<(&MemoryEntry, f32)> = self.cache.iter()
        .map(|entry| {
            let score = compute_relevance(entry, &context_words);
            (entry, score)
        })
        .collect();
    
    // 按相关度排序
    scored.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap());
    
    scored.into_iter()
        .take(limit)
        .map(|(entry, _)| entry)
        .collect()
}

fn compute_relevance(entry: &MemoryEntry, context_words: &[&str]) -> f32 {
    let entry_lower = entry.content.to_lowercase();
    let mut score = 0.0;
    
    // 关键词匹配得分
    for word in context_words {
        if entry_lower.contains(word) {
            score += 1.0;
        }
    }
    
    // 标签匹配加分
    for tag in &entry.tags {
        let tag_lower = tag.to_lowercase();
        for word in context_words {
            if tag_lower.contains(word) {
                score += 2.0;
            }
        }
    }
    
    // 访问频次加权
    score += entry.access_count as f32 * 0.1;
    
    // 时间衰减（最近访问的记忆权重更高）
    if let Some(last_accessed) = entry.last_accessed {
        let days_since = (Utc::now() - last_accessed).num_days();
        score += (30.0 - days_since as f32).max(0.0) * 0.05;
    }
    
    score
}
```

