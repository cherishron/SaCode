## API 设计

### MemoryStore

```rust
impl MemoryStore {
    /// 创建 MemoryStore
    pub fn new(workdir: &Path) -> Self;
    
    /// 加载所有记忆到内存
    pub fn load(&mut self) -> Result<()>;
    
    /// 保存所有记忆到磁盘
    pub fn save(&self) -> Result<()>;
    
    /// 添加记忆
    pub fn add(&mut self, entry: MemoryEntry) -> Result<()>;
    
    /// 删除记忆
    pub fn remove(&mut self, id: &str) -> Result<bool>;
    
    /// 搜索记忆（关键词匹配）
    pub fn search(&self, query: &str, limit: usize) -> Vec<&MemoryEntry>;
    
    /// 召回记忆（基于上下文）
    pub fn recall(&self, context: &str, limit: usize) -> Vec<&MemoryEntry>;
    
    /// 获取所有记忆
    pub fn list(&self) -> Vec<&MemoryEntry>;
    
    /// 按类型获取记忆
    pub fn list_by_kind(&self, kind: MemoryKind) -> Vec<&MemoryEntry>;
    
    /// 按范围获取记忆
    pub fn list_by_scope(&self, scope: MemoryScope) -> Vec<&MemoryEntry>;
    
    /// 增加访问计数
    pub fn touch(&mut self, id: &str);
}
