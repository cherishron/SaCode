## 自动注入机制

### 对话开始时自动 recall

在 `tool_chat` 开始时，自动 recall 相关 Memory：

```rust
pub async fn tool_chat<F>(
    &self,
    provider: &ModelProvider,
    system_prompt: &str,
    user_prompt: &str,
    tools: Vec<ToolDefinition>,
    tool_executor: F,
) -> Result<ToolChatResult>
where
    F: Fn(&str, &serde_json::Value) -> Result<serde_json::Value>,
{
    // 1. 自动召回 Memory
    let memory_context = auto_recall_memory(user_prompt);
    
    // 2. 组装增强的系统提示词
    let effective_system = if memory_context.is_empty() {
        system_prompt.to_string()
    } else {
        format!(
            "{}\n\n[Relevant Context from Memory]\n{}",
            system_prompt,
            memory_context
        )
    };
    
    let mut messages = vec![
        ChatMessage::system(&effective_system),
        ChatMessage::user(user_prompt),
    ];
    
    // ... rest of the method
}

fn auto_recall_memory(user_prompt: &str) -> String {
    let workdir = PathBuf::from(".");
    let mut store = MemoryStore::new(&workdir);
    
    if store.load().is_err() {
        return String::new();
    }
    
    let entries = store.recall(user_prompt, 5);
    
    if entries.is_empty() {
        return String::new();
    }
    
    let parts: Vec<String> = entries.iter()
        .map(|entry| format!("- [{}] {}", entry.kind.label(), entry.content))
        .collect();
    
    parts.join("\n")
}
```

### 对话结束时自动 remember（可选）

在关键节点（如任务完成、用户确认）时，Agent 可以调用 `memory.remember`：

```rust
// 任务完成后，自动保存关键信息
if task_completed {
    let key_info = extract_key_info(&messages);
    if !key_info.is_empty() {
        tool_registry.execute("memory.remember", serde_json::json!({
            "content": key_info,
            "kind": "fact",
            "scope": "project",
            "tags": ["auto-saved"]
        }));
    }
}
```

