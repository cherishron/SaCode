{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/core/src/index.ts",
    "packages/adapters/src/index.ts",
    "packages/auth/src/index.ts",
    "packages/database/src/index.ts",
    "packages/capabilities/src/index.ts",
    "packages/api/src/index.ts",
    "packages/cli/src/index.ts"
  ],
  "entryPointStrategy": "resolve",
  "out": "docs/api",
  "json": "docs/api/api.json",
  "name": "SaCode API Documentation",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "excludeExternals": true,
  "excludeNotDocumented": false,
  "categorizeByGroup": true,
  "categoryOrder": [
    "Core",
    "Adapters",
    "Auth",
    "Database",
    "Capabilities",
    "API",
    "CLI",
    "*"
  ],
  "defaultCategory": "Other",
  "readme": "./README.md",
  "githubPages": false,
  "gitRevision": "main",
  "hideGenerator": true,
  "navigationLinks": {
    "GitHub": "https://github.com/STAND-ALONE/SaCode"
  },
  "visibilityFilters": {
    "protected": true,
    "private": false,
    "inherited": true,
    "external": false
  },
  "sort": ["source-order"],
  "kindSortOrder": [
    "Document",
    "Reference",
    "Project",
    "Module",
    "Namespace",
    "Class",
    "Interface",
    "TypeAlias",
    "Enum",
    "Function",
    "Variable",
    "Property",
    "Method",
    "Accessor",
    "Parameter",
    "TypeParameter",
    "Getter",
    "Setter"
  ],
  "treatWarningsAsErrors": false,
  "treatValidationWarningsAsErrors": false,
  "intentionallyNotExported": [],
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  },
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": 100
  }
}
