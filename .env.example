# ============================================
# SaClaw 环境配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ============================================
# 服务器配置
# ============================================
PORT=3000
HOST=localhost
NODE_ENV=development

# 安全密钥 (生产环境必须设置)
# JWT_SECRET - JWT 签名密钥，建议 32 字符以上随机字符串
# SESSION_SECRET - Session 加密密钥，建议 32 字符以上随机字符串
# ENCRYPTION_KEY - 敏感数据加密密钥，建议 32 字符以上随机字符串
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=

# ============================================
# AI Provider 配置 (推荐)
# ============================================

# Provider 类型: openai | anthropic | deepseek | moonshot | zhipu
AI_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Anthropic (Claude) 配置
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=

# DeepSeek 配置 (国产模型，兼容 OpenAI API)
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat

# Moonshot (月之暗面) 配置
MOONSHOT_API_KEY=sk-xxx

# 智谱 AI 配置
ZHIPU_API_KEY=xxx

# ============================================
# iFlow SDK 配置 (Legacy - 已废弃)
# ============================================
# 注意: iFlow 服务已停止运营，请使用上方 AI Provider 配置
# IFLOW_ACP_URL=ws://localhost:8090/acp
# IFLOW_AUTO_START=true
# IFLOW_TIMEOUT=60000

# ============================================
# 数据库配置
# ============================================
# 数据库类型: sqlite | mysql | postgres
DATABASE_TYPE=sqlite

# SQLite 配置 (默认)
DATABASE_PATH=./data/saclaw.db

# MySQL 配置 (可选)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=saclaw
# MYSQL_USER=root
# MYSQL_PASSWORD=

# PostgreSQL 配置 (可选)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=saclaw
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=

# ============================================
# Redis 缓存配置 (可选)
# ============================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# 认证配置 - 本地账号
# ============================================
AUTH_LOCAL_ENABLED=true

# JWT 密钥 (生产环境必须更改)
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Session 密钥 (生产环境必须更改)
SESSION_SECRET=your-session-secret-change-in-production

# ============================================
# 认证配置 - OAuth
# ============================================

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/oauth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/oauth/google/callback

# 微信 OAuth
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=http://localhost:3000/api/auth/oauth/wechat/callback

# 企业微信 OAuth
WEWORK_CORP_ID=
WEWORK_AGENT_ID=
WEWORK_SECRET=
WEWORK_CALLBACK_URL=http://localhost:3000/api/auth/oauth/wework/callback

# QQ OAuth
QQ_APP_ID=
QQ_APP_KEY=
QQ_CALLBACK_URL=http://localhost:3000/api/auth/oauth/qq/callback

# ============================================
# IM 平台配置
# ============================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# 微信 Webhook
WECHAT_WEBHOOK_URL=

# 钉钉机器人
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_CARD_TEMPLATE_ID=

# 飞书机器人
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 华为小艺
XIAOYI_AK=
XIAOYI_SK=
XIAOYI_AGENT_ID=

# WhatsApp 桥接服务
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=

# ============================================
# 能力配置
# ============================================

# 文件系统
CAP_FILES_ENABLED=true
CAP_FILES_ALLOWED_DIRS=.
CAP_FILES_MAX_SIZE=10485760
CAP_FILES_READ_ONLY=false

# 浏览器控制
CAP_BROWSER_ENABLED=true
CAP_BROWSER_HEADLESS=true
CAP_BROWSER_TIMEOUT=30000

# Shell 命令
CAP_SHELL_ENABLED=true
CAP_SHELL_ALLOWED_COMMANDS=git,npm,pnpm,node
CAP_SHELL_TIMEOUT=60000

# ============================================
# Web UI 配置
# ============================================
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# ============================================
# Docker 部署配置
# ============================================
API_PORT=3000
WEB_PORT=5173
REDIS_PORT=6379

# ============================================
# Skills 注册中心 (可选)
# ============================================

# ClawHub (默认)
# CLAWHUB_URL=https://api.clawhub.ai/v1
# CLAWHUB_TOKEN=

# SkillHub (腾讯云镜像，国内加速)
# SKILLHUB_URL=https://skillhub.tencent.com/api/v1
# SKILLHUB_TOKEN=
