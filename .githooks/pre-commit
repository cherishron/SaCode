#!/bin/sh
# SaCode 预提交验证钩子
#
# 在每次 git commit 前执行快速验证：
#   1. cargo fmt --check 格式校验
#   2. cargo clippy 静态检查
#   3. cargo build --workspace 全量编译
#   4. cargo test --workspace --lib 单元测试
#
# 通过 core.hooksPath=.githooks 启用（见 scripts/setup-hooks.sh）。
# 跳过方式：git commit --no-verify（仅限紧急情况，应谨慎使用）。

set -e

# Git exports repository-local variables (GIT_DIR, GIT_WORK_TREE,
# GIT_INDEX_FILE, GIT_OBJECT_DIRECTORY, GIT_ALTERNATE_OBJECT_DIRECTORIES)
# to hooks. If left set, cargo test inherits them and tests that run
# `git init` / `git config` in temp directories accidentally target this
# repository instead of the temp dir. Clear them so tests are isolated.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

echo "==> [pre-commit] SaCode 提交前验证开始"

# Windows: disable debug info to avoid LNK1140 PDB size limit when
# linking large binaries (sacode-tui, sacode-desktop) in debug mode.
export CARGO_PROFILE_DEV_DEBUG=0
export CARGO_PROFILE_TEST_DEBUG=0

# 只对 Rust 相关变更做完整验证；纯文档变更跳过（提升体验）
if git diff --cached --name-only | grep -qE '\.(rs|toml)$'; then
    echo "==> [pre-commit] 检测到 Rust 变更，执行 cargo fmt --check"
    cargo fmt --check
    echo "==> [pre-commit] 格式校验通过，执行 cargo clippy"
    cargo clippy --workspace --lib 2>&1 | grep -v "warning:" || true
    echo "==> [pre-commit] clippy 检查通过，执行 cargo build --workspace"
    cargo build --workspace
    echo "==> [pre-commit] cargo build 通过，执行 cargo test --workspace --lib"
    cargo test --workspace --lib
    echo "==> [pre-commit] 单元测试全部通过"
else
    echo "==> [pre-commit] 无 Rust 变更，跳过编译与测试"
fi

echo "==> [pre-commit] 验证通过 ✓"
