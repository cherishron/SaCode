{
  "name": "@sa/web",
  "version": "0.1.0-w01",
  "private": true,
  "type": "module",
  "description": "SaCode Web 工作台 BFF + 前端（W01 骨架 + W02-A 安全只读 PoC）",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,bff -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "vue-tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "playwright test",
    "test:e2e:deploy": "playwright test --config=playwright.deploy.config.ts",
    "audit": "npm audit --package-lock-only"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@node-rs/argon2": "2.2.2",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.7",
    "markdown-it": "15.0.3",
    "pinia": "3.0.4",
    "pino": "10.4.0",
    "undici": "8.12.3",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fastify/type-provider-typebox": "6.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "concurrently": "9.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "16.5.0",
    "jsdom": "30.1.3",
    "prettier": "3.6.2",
    "tsx": "4.20.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.3.13"
  }
}
