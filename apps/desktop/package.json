{
  "name": "@stand-alone/sacode-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MulanPSL-2.0",
  "author": "SaCode",
  "main": "main.cjs",
  "scripts": {
    "vendor": "node ../../scripts/pack-vendor.mjs && node ../../scripts/pack-tinyvue.mjs && node ../../scripts/pack-tinyrobot.mjs && node ../../scripts/pack-pages.mjs",
    "prestart": "npm run vendor",
    "start": "electron .",
    "presmoke": "npm run vendor",
    "smoke": "electron . --smoke",
    "preui-smoke": "npm run vendor",
    "ui-smoke": "electron . --ui-smoke",
    "test": "node --test",
    "prelayout-smoke": "npm run vendor",
    "layout-smoke": "electron . --layout-smoke"
  },
  "build": {
    "appId": "com.cherishron.sacode.desktop",
    "productName": "SaCode",
    "directories": {
      "output": "dist/electron"
    },
    "asar": true,
    "files": [
      "main.cjs",
      "stdio-guard.cjs",
      "preload.cjs",
      "host-bridge.cjs",
      "models-guard.cjs",
      "customs-guard.cjs",
      "paths.cjs",
      "layout-smoke.cjs",
      "tooltip-smoke.cjs",
      "frame-smoke.cjs",
      "test-support/**",
      "package.json",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "dist/host/bin",
        "to": "host/bin"
      }
    ],
    "win": {
      "icon": "renderer/assets/sacode-icon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "SaCode Setup ${version}.exe"
    },
    "portable": {
      "artifactName": "sacode-portable.exe"
    }
  },
  "devDependencies": {
    "@opentiny/tiny-robot": "^0.5.1",
    "@opentiny/vue": "^3.32.0",
    "@opentiny/vue-button": "^3.32.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "shiki": "4.3.1",
    "vue": "^3.5.43",
    "@opentiny/next-sdk": "^0.4.11"
  }
}
