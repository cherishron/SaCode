{
  "name": "@dsh/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MulanPSL-2.0",
  "main": "main.cjs",
  "scripts": {
    "vendor": "node ../../scripts/pack-vendor.mjs && node ../../scripts/pack-tinyvue.mjs && node ../../scripts/pack-tinyrobot.mjs",
    "prestart": "npm run vendor",
    "start": "electron .",
    "presmoke": "npm run vendor",
    "smoke": "electron . --smoke",
    "preui-smoke": "npm run vendor",
    "ui-smoke": "electron . --ui-smoke",
    "test": "node --test"
  },
  "build": {
    "appId": "cn.dsh.desktop",
    "productName": "DSH Desktop",
    "directories": {
      "output": "dist/electron"
    },
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "host-bridge.cjs",
      "paths.cjs",
      "package.json",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "dist/host/bin",
        "to": "host/bin"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DSH Desktop Setup ${version}.exe"
    },
    "portable": {
      "artifactName": "dsh-desktop-portable.exe"
    }
  },
  "devDependencies": {
    "@opentiny/tiny-robot": "^0.5.1",
    "@opentiny/vue": "^3.32.0",
    "@opentiny/vue-button": "^3.32.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "vue": "^3.5.43"
  }
}
