{
    "app": {
        "signingConfigs": [],
        "products": [
            {
                "name": "default",
                "signingConfig": "default",
                "compatibleSdkVersion": "5.0.0(12)",
                "runtimeOS": "HarmonyOS"
            }
        ],
        "buildModeSet": [
            {
                "name": "debug",
                "signingConfig": "default"
            },
            {
                "name": "release",
                "signingConfig": "default"
            }
        ]
    },
    "modules": [
        {
            "name": "entry",
            "srcPath": "./entry",
            "targets": [
                {
                    "name": "default",
                    "applyToProducts": [
                        "default"
                    ]
                }
            ]
        }
    ]
}