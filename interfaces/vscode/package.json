{
  "name": "sacode-vscode",
  "displayName": "SaCode",
  "description": "SaCode AI coding agent integration for VS Code",
  "version": "0.2.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "sacode": {
    "minimumDaemonVersion": "1.1.1"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sacode",
          "title": "SaCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sacode": [
        {
          "id": "sacode-panel",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "sacode.runTask",
        "title": "SaCode: Run Task",
        "icon": "$(play)"
      },
      {
        "command": "sacode.configure",
        "title": "SaCode: Configure"
      },
      {
        "command": "sacode.status",
        "title": "SaCode: Check Status"
      },
      {
        "command": "sacode.stop",
        "title": "SaCode: Stop Task",
        "icon": "$(stop)"
      },
      {
        "command": "sacode.restartDaemon",
        "title": "SaCode: Restart Daemon"
      }
    ],
    "configuration": {
      "title": "SaCode",
      "properties": {
        "sacode.daemonHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "SaCode daemon host"
        },
        "sacode.daemonPort": {
          "type": "number",
          "default": 8080,
          "description": "SaCode daemon port"
        },
        "sacode.binaryPath": {
          "type": "string",
          "default": "sacode",
          "description": "Path to the sacode binary (if not in PATH, use full path)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "package:vsix": "vsce package --no-dependencies --out sacode-vscode-0.2.1.vsix && python ../../scripts/normalize-vsix.py sacode-vscode-0.2.1.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.0.0"
  },
  "publisher": "cherishron",
  "license": "MulanPSL-2.0",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/cherishron/SaCode.git"
  }
}
