{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaCode Desktop",
  "identifier": "com.cherishron.sacode.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run bundle:sidecar && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' asset:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "title": "SaCode Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/sacode"],
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 %1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFQjJGNkJENDlBMEYxQTcKUldTbjhhQkp2ZmF5M3JIWldReFQ1UzBwbHdXTlNzZWY2cFE1TGtVdURTMWVCcGRLd0RxeXgvK1QK"
    }
  }
}
