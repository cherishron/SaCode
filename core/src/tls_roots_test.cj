@Test
func tlsRootsFromPemParsesEveryCertificateInBundle() {
    @Expect(tlsRootsFromPem(BUNDLE_TWO_ROOTS).size, Int64(2))
}

@Test
func tlsRootsFromPemOnGarbageYieldsNoAnchors() {
    // 空数组不是「解析失败就算通过」：调用方据此退回 Default，
    // 而 Default 在无锚机器上等于连不上——但它至少不等于关掉校验。
    @Expect(tlsRootsFromPem("not a certificate at all").size, Int64(0))
    @Expect(tlsRootsFromPem("").size, Int64(0))
}

@Test
func clientTlsConfigWithRootsVerifiesAgainstThoseRoots() {
    let roots = tlsRootsFromPem(BUNDLE_TWO_ROOTS)
    let anchors = match (clientTlsConfigWithRoots(roots).verifyMode) {
        case CertificateVerifyMode.CustomCA(certs) => certs.size
        case _ => -1
    }
    @Expect(anchors, Int64(2))
}

@Test
func clientTlsConfigWithoutRootsStaysOnDefaultNeverTrustAll() {
    // 这条是「绝不关校验」的钉子：没有锚时必须留在 Default（在该机器上就是连不通、
    // 并如实报 http-request-error），不能悄悄换成 TrustAll 让它「能用」。
    let tag = match (clientTlsConfigWithRoots(tlsRootsFromPem("")).verifyMode) {
        case CertificateVerifyMode.Default => Int64(0)
        case _ => Int64(1)
    }
    @Expect(tag, Int64(0))
}

@Test
func tlsRootsFromMissingBundleFileYieldsNoAnchors() {
    // 路径不存在不是错误：装配层按「无锚」处理，交给上一条钉子决定退到哪。
    @Expect(tlsRootsFromBundle("Z:/definitely/not/here/sacode-ca.pem").size, Int64(0))
}
