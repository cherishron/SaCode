{
  "name": "sacode",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*"],
  "description": "SaCode - 基于 Provider 抽象层的多端 AI 助手框架，支持 OpenAI/Anthropic/DeepSeek/Moonshot/智谱，以及 10 个 IM 平台",
  "keywords": [
    "ai",
    "assistant",
    "openai",
    "anthropic",
    "deepseek",
    "chatbot",
    "agentic",
    "function-calling",
    "mcp",
    "multi-platform",
    "wechat",
    "telegram",
    "discord",
    "cli"
  ],
  "author": "STAND-ALONE <1635936133@qq.com>",
  "license": "MulanPSL-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun run --filter \"./packages/*\" dev",
    "build": "bun run --filter \"./packages/*\" build",
    "build:clean": "bun scripts/build.js clean",
    "build:validate": "bun scripts/build.js validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:run": "cross-env RUN_E2E_TESTS=true vitest run --config vitest.e2e.config.ts",
    "lint": "eslint packages --ext .ts,.tsx",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\"",
    "clean": "bun run --filter \"./packages/*\" clean",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "cli": "bun packages/cli/dist/cli.js",
    "web": "bun run --filter \"./packages/web\" dev",
    "api": "bun run --filter \"./packages/api\" dev",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:serve": "typedoc --watch --open",
    "release": "bun scripts/release.js",
    "release:minor": "bun scripts/release.js minor",
    "release:major": "bun scripts/release.js major",
    "docker:build": "bun scripts/docker-build.js build",
    "docker:push": "bun scripts/docker-build.js push",
    "docker:all": "bun scripts/docker-build.js all",
    "docker:prune": "bun scripts/docker-build.js prune",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:dev": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@prisma/engines": "6.19.3",
    "@rollup/rollup-win32-x64-msvc": "^4.60.2",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "c12": "^4.0.0-beta.4",
    "effect": "^3.21.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.16.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^15.2.10",
    "pathe": "^2.0.3",
    "picomatch": "^4.0.4",
    "prettier": "^3.4.2",
    "rollup": "^4.60.2",
    "tsup": "^8.3.5",
    "typedoc": "^0.27.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  }
}
