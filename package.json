{
  "name": "sacode",
  "version": "1.0.0",
  "private": true,
  "description": "SaCode - 基于 Provider 抽象层的多端 AI 助手框架，支持 OpenAI/Anthropic/DeepSeek/Moonshot/智谱，以及 10 个 IM 平台",
  "keywords": [
    "ai",
    "assistant",
    "openai",
    "anthropic",
    "deepseek",
    "chatbot",
    "agentic",
    "function-calling",
    "mcp",
    "multi-platform",
    "wechat",
    "telegram",
    "discord",
    "cli"
  ],
  "author": "STAND-ALONE <1635936133@qq.com>",
  "license": "MulanPSL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter \"./packages/*\" run dev",
    "build": "pnpm --filter \"./packages/*\" run build",
    "build:clean": "node scripts/build.js clean",
    "build:validate": "node scripts/build.js validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:run": "cross-env RUN_E2E_TESTS=true vitest run --config vitest.e2e.config.ts",
    "lint": "eslint packages --ext .ts,.tsx",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\"",
    "clean": "pnpm --filter \"./packages/*\" run clean",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "cli": "bun packages/cli/dist/cli.js",
    "web": "pnpm --filter \"./packages/web\" run dev",
    "api": "pnpm --filter \"./packages/api\" run dev",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:serve": "typedoc --watch --open",
    "release": "node scripts/release.js",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "docker:build": "node scripts/docker-build.js build",
    "docker:push": "node scripts/docker-build.js push",
    "docker:all": "node scripts/docker-build.js all",
    "docker:prune": "node scripts/docker-build.js prune",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:dev": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "typedoc": "^0.27.6",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  }
}
