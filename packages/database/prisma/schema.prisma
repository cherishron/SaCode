generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id            String      @id @default(uuid())
  username      String?     @unique
  password      String?
  email         String?     @unique
  avatar        String?
  oauthProvider String?     @map("oauth_provider")
  oauthId       String?     @map("oauth_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  sessions      Session[]
  chatSessions  ChatSession[]
  cronTasks     CronTask[]

  @@map("users")
}

// 会话表（登录会话）
model Session {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

// 聊天会话表
model ChatSession {
  id          String        @id @default(uuid())
  userId      String?       @map("user_id")
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  channelId   String?       @map("channel_id")
  platform    String?
  title       String?
  modelId     String?       @map("model_id")   // 当前使用的模型 ID
  memory      String?       // 会话记忆 (MEMORY.md 内容)
  context     String?       // 上下文摘要 (JSON)
  settings    String?       // 会话设置 (JSON)
  messages    ChatMessage[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("chat_sessions")
}

// 聊天消息表
model ChatMessage {
  id          String      @id @default(uuid())
  sessionId   String      @map("session_id")
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String      // user | assistant | system | tool
  content     String
  contentType String?     @map("content_type") // text | image | audio | video | file | mixed
  mediaUrl    String?     @map("media_url")    // 媒体文件 URL
  mediaMeta   String?     @map("media_meta")   // 媒体元数据 (JSON)
  toolName    String?     @map("tool_name")
  toolStatus  String?     @map("tool_status")
  metadata    String?     // JSON
  tokenCount  Int?        @map("token_count") // Token 数量
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("chat_messages")
}

// IM 连接配置表
model IMConnection {
  id          String   @id @default(uuid())
  platform    String   // wechat | qq | telegram | discord | dingtalk | feishu
  name        String?
  status      String   // connected | disconnected | error
  config      String   // JSON 配置
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("im_connections")
}

// 插件表
model Plugin {
  id          String   @id @default(uuid())
  name        String   @unique
  version     String
  description String?
  enabled     Boolean  @default(false)
  config      String?  // JSON 配置
  installedAt DateTime @default(now()) @map("installed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("plugins")
}

// 系统配置表
model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// 定时任务表
model CronTask {
  id              String    @id @default(uuid())
  name            String
  type            String    // 'interval' | 'once' | 'cron'
  config          String    // JSON 任务配置 {interval?, executeAt?, cronExpression?}
  message         String    // 要发送的消息内容
  channel         String    // 目标平台
  chatId          String    @map("chat_id")
  enabled         Boolean   @default(true)
  lastRunAt       DateTime? @map("last_run_at")
  nextRunAt       DateTime? @map("next_run_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  userId          String?   @map("user_id")
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cron_tasks")
}

// 会话映射表 - 跨渠道会话映射
model SessionMapping {
  id            String   @id @default(uuid())
  channel       String   // 平台
  chatId        String   @map("chat_id")
  sessionId     String   @unique @map("session_id") // SaClaw 会话 ID
  createdAt     DateTime @default(now()) @map("created_at")
  lastActiveAt  DateTime @default(now()) @map("last_active_at")

  @@unique([channel, chatId])
  @@map("session_mappings")
}

// 沙箱配置表
model SandboxConfig {
  id              String   @id @default(uuid())
  name            String   @unique
  mode            String   // 'none' | 'docker' | 'vm' | 'bwrap'
  enabled         Boolean  @default(false)
  config          String?  // JSON 容器配置
  allowedCommands String?  // JSON 命令白名单
  allowedPaths    String?  // JSON 文件访问限制
  allowedNetworks String?  // JSON 网络限制
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("sandbox_configs")
}

// 工作流表 - Agent Swarm工作流
model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   // 'swarm' | 'pipeline' | 'chain'
  status      String   @default("idle") // 'idle' | 'running' | 'paused' | 'completed' | 'failed'
  config      String   // JSON 工作流配置
  nodeConfig  String?  @map("node_config") // JSON 节点配置
  edges       String?  // JSON 边配置
  result      String?  // JSON 执行结果
  error       String?  // 错误信息
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  nodes       WorkflowNode[]

  @@map("workflows")
}

// 工作流节点表
model WorkflowNode {
  id          String   @id @default(uuid())
  workflowId  String   @map("workflow_id")
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name        String
  type        String   // 'agent' | 'tool' | 'condition' | 'merge'
  config      String   // JSON 节点配置
  positionX   Int?     @map("position_x")
  positionY   Int?     @map("position_y")
  status      String?  // 节点状态
  result      String?  // JSON 节点结果
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("workflow_nodes")
}

// 智能路由规则表
model RoutingRule {
  id          String   @id @default(uuid())
  name        String
  priority    Int      @default(0)
  condition   String   // JSON 路由条件
  action      String   // JSON 路由动作: {type: 'model'|'agent'|'channel', value: string}
  enabled     Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("routing_rules")
}

// API 密钥表 - AI 提供商密钥管理
model ApiKey {
  id          String   @id @default(uuid())
  provider    String   @unique // openai | anthropic | deepseek | moonshot | zhipu | google | azure
  name        String   // 显示名称
  apiKey      String   @map("api_key") // 加密存储的 API Key
  baseUrl     String?  @map("base_url") // 自定义 API 地址
  enabled     Boolean  @default(true)
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("api_keys")
}

// OAuth 配置表 - OAuth 提供商配置
model OAuthConfig {
  id           String   @id @default(uuid())
  provider     String   @unique // github | google | wechat | wework | qq
  name         String   // 显示名称
  clientId     String   @map("client_id") // 加密存储
  clientSecret String   @map("client_secret") // 加密存储
  callbackUrl  String?  @map("callback_url") // 回调地址
  corpId       String?  @map("corp_id") // 企业微信 CorpID
  agentId      String?  @map("agent_id") // 企业微信 AgentID
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("oauth_configs")
}

// OAuth State 表 - 存储 OAuth 认证过程中的 state 参数
model OAuthState {
  id        String   @id @default(uuid())
  state     String   @unique // 随机生成的 state 参数
  provider  String   // oauth 提供商
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at") // 过期时间（5分钟）

  @@index([state])
  @@index([expiresAt])
  @@map("oauth_states")
}
