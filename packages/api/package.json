{
  "name": "@sacode/api",
  "version": "0.1.0",
  "description": "SACODE API 服务 - REST API 与 WebSocket",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --clean",
    "dev": "bun run --watch src/server.ts",
    "start": "bun run dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sacode/adapters": "workspace:*",
    "@sacode/auth": "workspace:*",
    "@sacode/capabilities": "workspace:*",
    "@sacode/core": "workspace:*",
    "@sacode/database": "workspace:*",
    "@hono/zod-validator": "^0.4.2",
    "bcryptjs": "^2.4.3",
    "hono": "^4.7.4",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
