{
  "name": "@SACODE/integrations",
  "version": "0.1.0",
  "description": "GitHub, GitLab, and other platform integrations for SACODE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./git": {
      "types": "./dist/git/index.d.ts",
      "import": "./dist/git/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/git/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/git/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "SACODE",
    "github",
    "gitlab",
    "git",
    "integration"
  ],
  "license": "MIT"
}
