{
  "name": "@sacode/web",
  "version": "0.1.0",
  "description": "SACODE Web UI - Vue 3 + TinyVue",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
