    "@sacode/core": "workspace:*",
    "dompurify": "^3.3.3",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.4",
    "pinia": "^2.3.0",
    "tdesign-icons-vue-next": "^0.4.2",
    "tdesign-vue-next": "^1.18.5",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^16.0.0",
    "postcss": "^8.4.49",
