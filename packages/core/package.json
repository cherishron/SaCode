{
  "name": "@sacode/core",
  "version": "0.2.0",
  "description": "SACODE 核心引擎 - Provider 抽象层与会话管理",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc --noEmit -p tsconfig.src.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@sacode/container": "workspace:*",
    "@sacode/types": "workspace:*",
    "eventemitter3": "^5.0.1",
    "execa": "^9.5.2",
    "openai": "^4.85.0",
    "pino": "^9.5.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
