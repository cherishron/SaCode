{
  "name": "@cherishron/sacode-cli",
  "version": "0.2.0",
  "description": "SaCode CLI - 多端 AI 助手命令行工具，支持 OpenAI/Anthropic/DeepSeek/Moonshot/智谱",
  "type": "module",
  "bin": {
    "sacode": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.2.23"
  },
  "keywords": [
    "ai",
    "cli",
    "assistant",
    "openai",
    "anthropic",
    "deepseek",
    "chatbot",
    "agentic",
    "sacode"
  ],
  "scripts": {
    "dev": "bun run --hot src/cli.ts",
    "build": "bun run build.ts",
    "build:exe": "bun build src/cli.ts --compile --outfile sacode --minify --sourcemap",
    "start": "bun run dist/cli.js",
    "test": "bun test",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "enquirer": "^2.4.1",
    "figlet": "^1.11.0",
    "highlight.js": "^11.11.1",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "nanoid": "^5.0.0",
    "ora": "^8.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.4",
    "zod": "^3.24.1"
  }
}
