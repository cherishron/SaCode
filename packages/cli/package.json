{
  "name": "@SACODE/cli",
  "version": "0.1.0",
  "description": "SACODE CLI 工具 - 基于 Bun 运行时",
  "type": "module",
  "bin": {
    "sacode": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "bun run --hot src/cli.ts",
    "build": "bun run build.ts",
    "start": "bun run dist/cli.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@SACODE/core": "workspace:*",
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "enquirer": "^2.4.1",
    "figlet": "^1.11.0",
    "highlight.js": "^11.11.1",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "nanoid": "^5.0.0",
    "ora": "^8.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/figlet": "^1.7.0",
    "typescript": "^5.7.2"
  }
}
